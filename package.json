{
  "name": "discord-term-project",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "workspaces": [
    "services/*",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev:frontend:staging",
    "dev:all": "concurrently -n auth,create-community,communities,messages,search,realtime,dms,frontend -c auto \"npm run dev:auth\" \"npm run dev:create-community\" \"npm run dev:communities\" \"npm run dev:messages\" \"npm run dev:search\" \"npm run dev:realtime\" \"npm run dev:dms\" \"VITE_API_ORIGIN=http://localhost npm run dev:frontend\"",
    "dev:local": "docker compose up -d && npm run dev:all",
    "dev:frontend:staging": "VITE_API_ORIGIN=http://130.245.136.45 npm run dev:frontend",
    "dev:frontend:local": "VITE_API_ORIGIN=http://localhost npm run dev:frontend",
    "dev:auth": "npm run dev --workspace auth-service",
    "dev:create-community": "npm run dev --workspace create-community-service",
    "dev:communities": "npm run dev --workspace communities-service",
    "dev:messages": "npm run dev --workspace messages-service",
    "dev:search": "npm run dev --workspace search-service",
    "dev:realtime": "npm run dev --workspace realtime-service",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build:auth && npm run build:frontend",
    "build:auth": "npm run build --workspace auth-service",
    "build:frontend": "npm run build --workspace frontend",
    "db:generate": "npm run db:generate --workspace auth-service",
    "db:migrate": "npm run db:migrate --workspace auth-service",
    "dev:dms": "npm run dev --workspace dms-service",
    "diagnostics:local": "bash ./scripts/collect-diagnostics.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "openid-client": "^6.8.2",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.20.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pg": "^8.18.0",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.0.1",
    "drizzle-kit": "^0.31.9",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
