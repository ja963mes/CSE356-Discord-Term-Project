PORT=3001
COMMUNITIES_PORT=3002
CREATE_COMMUNITY_PORT=3006
SEARCH_COMMUNITIES_PORT=3007
FRONTEND_URL=http://localhost:5173

# Database
# Use port 5433 if you start Postgres with `docker compose up` (default host mapping).
# Use 5432 if Postgres listens on the host default port (e.g. local/Homebrew only).
DATABASE_URL=postgresql://postgres:REPLACE_WITH_PASSWORD@localhost:5433/auth_db

# Redis
REDIS_URL=redis://localhost:6379

# Session (must be >= 16 characters)
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
FRONTEND_URL=http://localhost:5173

# OAuth - Google
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# OAuth - GitHub
GITHUB_CLIENT_ID=REPLACE_WITH_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_GITHUB_CLIENT_SECRET
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback

# OIDC - Course Provider (CSE 356 Keycloak)
OIDC_ISSUER_URL=https://infra-auth.cse356.compas.cs.stonybrook.edu/realms/oauth
OIDC_CLIENT_ID=web-service
OIDC_CLIENT_SECRET=REPLACE_WITH_OIDC_CLIENT_SECRET
OIDC_CALLBACK_URL=http://localhost:3001/auth/oidc/callback

