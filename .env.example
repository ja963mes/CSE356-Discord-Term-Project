PORT=3001
COMMUNITIES_PORT=3002
# Communities service (Pino): trace | debug | info | warn | error | fatal
# LOG_LEVEL=info
# Communities service (Pino): pretty-print logs for tail/journalctl readability
# LOG_PRETTY=true
CREATE_COMMUNITY_PORT=3006
FRONTEND_URL=http://130.245.136.115

# Staging host (Linode)
# Keep as an IP until DNS is configured, then replace with your domain.
STAGING_HOST=130.245.136.72

# Database
# With Docker Compose: Postgres is on host POSTGRES_PORT (default 5433). PgBouncer pools
# connections on PGBOUNCER_PORT (default 6432) in transaction mode.
#
# Apps (all services): prefer DATABASE_URL through PgBouncer when `pgbouncer` is running
# (compose uses AUTH_TYPE=scram-sha-256 so Node/pg and Postgres 16 agree on SCRAM).
DATABASE_URL=postgresql://postgres:REPLACE_WITH_PASSWORD@localhost:6432/auth_db
# Drizzle migrations / psql admin: bypass PgBouncer (same password as POSTGRES_PASSWORD):
DATABASE_URL_DIRECT=postgresql://postgres:REPLACE_WITH_PASSWORD@localhost:5433/auth_db
#
# If you stop the pgbouncer service, set DATABASE_URL to the same host/port as DIRECT.
# POSTGRES_PASSWORD must match docker-compose `postgres` and `pgbouncer` (default 123456789).
# POSTGRES_PASSWORD=123456789
# PGBOUNCER_PORT=6432
# PGBOUNCER_DEFAULT_POOL_SIZE=20

# Redis
REDIS_URL=redis://localhost:6379

# Session (must be >= 16 characters)
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
FRONTEND_URL=http://130.245.136.115

# Staging URL examples (when deploying remotely with reverse proxy)
# FRONTEND_URL=http://130.245.136.115
# GOOGLE_CALLBACK_URL=http://130.245.136.115/auth/google/callback
# GITHUB_CALLBACK_URL=http://130.245.136.115/auth/github/callback
# OIDC_CALLBACK_URL=http://130.245.136.115/auth/oidc/callback

# OAuth - Google
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# OAuth - GitHub
GITHUB_CLIENT_ID=REPLACE_WITH_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_GITHUB_CLIENT_SECRET
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback

# OIDC - Course Provider (CSE 356 Keycloak)
OIDC_ISSUER_URL=https://infra-auth.cse356.compas.cs.stonybrook.edu/realms/oauth
OIDC_CLIENT_ID=web-service
OIDC_CLIENT_SECRET=REPLACE_WITH_OIDC_CLIENT_SECRET
OIDC_CALLBACK_URL=http://localhost:3001/auth/oidc/callback

# Cassandra (messages service — channel history; DM service — conversations)
# Defaults match docker-compose (9042 on localhost).
CASSANDRA_CONTACT_POINTS=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_LOCAL_DATACENTER=datacenter1
# Guild channel messages keyspace (DM service uses CASSANDRA_KEYSPACE=dms — keep these separate).
MESSAGES_CASSANDRA_KEYSPACE=messaging
# simple = SimpleStrategy; network = NetworkTopologyStrategy (set DC to match your cluster)
CASSANDRA_TOPOLOGY=simple
CASSANDRA_REPLICATION_FACTOR=1
CASSANDRA_READ_CONSISTENCY=localOne
CASSANDRA_WRITE_CONSISTENCY=localQuorum

# Docker Compose — Cassandra JVM + memory cap (staging / small VMs; optional)
# CASSANDRA_MAX_HEAP=512M
# CASSANDRA_HEAP_NEW=128M
# CASSANDRA_MEM_LIMIT=512m

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_MEM_LIMIT=512m

# MinIO (S3-compatible object storage for message attachments)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=discord-attachments
