PORT=3001
COMMUNITIES_PORT=3002
CREATE_COMMUNITY_PORT=3006
FRONTEND_URL=http://localhost:5173

# Staging host (Linode)
# Keep as an IP until DNS is configured, then replace with your domain.
STAGING_HOST=130.245.136.72

# Database
# Use port 5433 if you start Postgres with `docker compose up` (default host mapping).
# Use 5432 if Postgres listens on the host default port (e.g. local/Homebrew only).
DATABASE_URL=postgresql://postgres:REPLACE_WITH_PASSWORD@localhost:5433/auth_db

# Redis
REDIS_URL=redis://localhost:6379

# Session (must be >= 16 characters)
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING
FRONTEND_URL=http://localhost:5173

# Staging URL examples (when deploying remotely with reverse proxy)
# FRONTEND_URL=http://130.245.136.72
# GOOGLE_CALLBACK_URL=http://130.245.136.72/auth/google/callback
# GITHUB_CALLBACK_URL=http://130.245.136.72/auth/github/callback
# OIDC_CALLBACK_URL=http://130.245.136.72/auth/oidc/callback

# OAuth - Google
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# OAuth - GitHub
GITHUB_CLIENT_ID=REPLACE_WITH_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_WITH_GITHUB_CLIENT_SECRET
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback

# OIDC - Course Provider (CSE 356 Keycloak)
OIDC_ISSUER_URL=https://infra-auth.cse356.compas.cs.stonybrook.edu/realms/oauth
OIDC_CLIENT_ID=web-service
OIDC_CLIENT_SECRET=REPLACE_WITH_OIDC_CLIENT_SECRET
OIDC_CALLBACK_URL=http://localhost:3001/auth/oidc/callback

# Cassandra (messages service — channel history; DM service — conversations)
# Defaults match docker-compose (9042 on localhost).
CASSANDRA_CONTACT_POINTS=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_LOCAL_DATACENTER=datacenter1
# Guild channel messages keyspace (DM service uses CASSANDRA_KEYSPACE=dms — keep these separate).
MESSAGES_CASSANDRA_KEYSPACE=messaging
# simple = SimpleStrategy; network = NetworkTopologyStrategy (set DC to match your cluster)
CASSANDRA_TOPOLOGY=simple
CASSANDRA_REPLICATION_FACTOR=1
CASSANDRA_READ_CONSISTENCY=localOne
CASSANDRA_WRITE_CONSISTENCY=localQuorum

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# MinIO (S3-compatible object storage for message attachments)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=discord-attachments
