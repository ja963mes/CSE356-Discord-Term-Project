LOG_LEVEL={{ auth_log_level | default('info') }}
LOG_PRETTY={{ auth_log_pretty | default('false') }}

PORT={{ auth_port | default('3001') }}
DATABASE_URL={{ auth_database_url }}
REDIS_URL={{ auth_redis_url }}
SESSION_SECRET={{ auth_session_secret }}
FRONTEND_URL={{ auth_frontend_url | default('http://localhost:5173') }}

OIDC_ISSUER_URL={{ auth_oidc_issuer_url | default('') }}
OIDC_CLIENT_ID={{ auth_oidc_client_id | default('web-service') }}
OIDC_CLIENT_SECRET={{ auth_oidc_client_secret | default('web-service-secret') }}
OIDC_CALLBACK_URL={{ auth_oidc_callback_url | default('') }}
