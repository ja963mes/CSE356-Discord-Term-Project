# Nginx — production (static SPA + API + WebSocket)
#
# Same path order as docs/nginx-linode-staging.conf.example and frontend/vite.config.ts.
# Differs from staging: serves built frontend from disk (not Vite :5173) and uses
# upstream keepalive pools to reduce TCP churn under load.
#
# Backend services (127.0.0.1):
#   3001 auth   3002 communities   3003 messages   3004 search
#   3005 realtime (/ws)   3006 create-community   3007 dms   3008 read-state
#
# --- Deploy on the server (summary) ---
# Static files: default `root` below is /var/www/discord-frontend (not under /root or /opt).
# Nginx reads files as www-data; home dirs like /root are often unreadable → 403/500 if you
# point root at ~/.../frontend/dist without fixing permissions.
#
# 1. One-time: sudo mkdir -p /var/www/discord-frontend
#    sudo chown root:www-data /var/www/discord-frontend && sudo chmod 750 /var/www/discord-frontend
# 2. Build: cd repo && npm ci && npm run build --workspace frontend
# 3. Publish build to nginx root (re-run after every frontend deploy):
#    sudo rsync -a --delete /path/to/repo/frontend/dist/ /var/www/discord-frontend/
#    sudo chmod -R g+rX /var/www/discord-frontend
# 4. Copy this file: sudo cp .../docs/nginx-linode-production.conf.example \
#       /etc/nginx/sites-available/discord-production
# 5. Edit: server_name, optional comment /search block if search not running
# 6. Enable: sudo ln -sf /etc/nginx/sites-available/discord-production /etc/nginx/sites-enabled/
# 7. sudo nginx -t && sudo systemctl reload nginx
# 8. TLS: sudo certbot --nginx -d your.domain  (or add the HTTPS server block below manually)
#
# --- TLS (after HTTP works) ---
# Option A: certbot --nginx (recommended) — it can add ssl_* and a redirect from :80.
# Option B: Uncomment the second server block below and set ssl_certificate paths, then add
#   a minimal :80 server that only does return 301 https://$host$request_uri;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Keepalive pools to Node upstreams (HTTP API only; /ws uses Upgrade and stays separate)
upstream backend_auth {
    server 127.0.0.1:3001;
    keepalive 32;
}
upstream backend_communities {
    server 127.0.0.1:3002;
    keepalive 32;
}
upstream backend_messages {
    server 127.0.0.1:3003;
    keepalive 32;
}
upstream backend_search {
    server 127.0.0.1:3004;
    keepalive 16;
}
upstream backend_realtime {
    server 127.0.0.1:3005;
    keepalive 8;
}
upstream backend_create_community {
    server 127.0.0.1:3006;
    keepalive 16;
}
upstream backend_dms {
    server 127.0.0.1:3007;
    keepalive 32;
}
upstream backend_read_state {
    server 127.0.0.1:3008;
    keepalive 16;
}

limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=100r/s;

# Per-IP rate limit keyed only on CPU-heavy POST endpoints (bcrypt)
map "$request_method$uri" $auth_bcrypt_ip_key {
    default                        "";
    "~^POST/auth/login$"           $binary_remote_addr;
    "~^POST/auth/register$"        $binary_remote_addr;
    "~^POST/auth/oauth/complete$"  $binary_remote_addr;
}
limit_req_zone $auth_bcrypt_ip_key zone=auth_bcrypt_per_ip:10m rate=5r/s;

# Global (all-IP) rate limit for bcrypt-heavy POST endpoints
map "$request_method$uri" $auth_bcrypt_global_key {
    default                        "";
    "~^POST/auth/login$"           "bcrypt";
    "~^POST/auth/register$"        "bcrypt";
    "~^POST/auth/oauth/complete$"  "bcrypt";
}
limit_req_zone $auth_bcrypt_global_key zone=auth_bcrypt_global:1m rate=30r/s;

# REPLACE: your public hostname(s) or staging IP
server {
    listen 80;
    listen 443 ssl;
    server_name 130.245.136.45 group-6.cse356.compas.cs.stonybrook.edu;

    ssl_certificate /etc/letsencrypt/live/group-6.cse356.compas.cs.stonybrook.edu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/group-6.cse356.compas.cs.stonybrook.edu/privkey.pem;

    client_max_body_size 25m;

    # --- API routes (prefix order matches staging; /search-communities before /search) ---

    location ^~ /auth {
        limit_req zone=auth_limit burst=200 nodelay;
        limit_req zone=auth_bcrypt_per_ip burst=10 nodelay;
        limit_req zone=auth_bcrypt_global burst=50 nodelay;
        limit_req_status 429;
        proxy_pass http://backend_auth;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /create-community {
        proxy_pass http://backend_create_community;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /communities {
        proxy_pass http://backend_communities;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /channels {
        proxy_pass http://backend_communities;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /messages {
        proxy_pass http://backend_messages;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /attachments {
        proxy_pass http://backend_messages;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /search-communities {
        proxy_pass http://backend_communities;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Comment out if search-service / ES is not running (avoids 502 on /search)
    location ^~ /search {
        proxy_pass http://backend_search;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /dms {
        proxy_pass http://backend_dms;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /read-state {
        proxy_pass http://backend_read_state;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WebSocket: do not use the keepalive Connection "" pattern here
    location ^~ /ws {
        proxy_pass http://backend_realtime;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }

    # --- Static SPA (Vite build) — default docroot for www-data ---
    # Keep built files in /var/www/... and rsync from repo after `npm run build --workspace frontend`.
    # Must contain index.html. Named @spa avoids "rewrite cycle" (500) if index.html is missing.
    root /var/www/discord-frontend;
    index index.html;
    location / {
        try_files $uri $uri/ @spa;
    }
    location @spa {
        rewrite ^ /index.html break;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;
    gzip_min_length 256;
}

# --- Optional HTTPS (uncomment and fix paths after: sudo certbot certonly --nginx -d YOUR_DOMAIN) ---
#
# server {
#     listen 443 ssl http2;
#     server_name YOUR_DOMAIN_OR_IP;
#
#     ssl_certificate     /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem;
#     include /etc/letsencrypt/options-ssl-nginx.conf;
#     ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
#
#     client_max_body_size 25m;
#     # Paste the same location blocks as the :80 server above (auth through /ws + root/try_files + gzip)
# }
#
# server {
#     listen 80;
#     server_name YOUR_DOMAIN_OR_IP;
#     return 301 https://$host$request_uri;
# }
