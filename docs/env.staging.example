STAGING_HOST=130.245.136.45
FRONTEND_URL=http://130.245.136.45

# Services (staging)
PORT=3001
COMMUNITIES_PORT=3002
CREATE_COMMUNITY_PORT=3006
REALTIME_PORT=3005

# Data deps (on staging server)
# Runtime via PgBouncer (docker compose `pgbouncer` → host 6432). Migrations/admin → 5433.
DATABASE_URL=postgresql://postgres:REPLACE_WITH_PASSWORD@localhost:6432/auth_db
DATABASE_URL_DIRECT=postgresql://postgres:REPLACE_WITH_PASSWORD@localhost:5433/auth_db
REDIS_URL=redis://10.0.3.49:6379
# KV instance lives on the same Redis VM but on a separate redis-server (port 6380)
# so sessions / cache / presence reads don't queue behind pubsub fanout.
KV_REDIS_URL=redis://10.0.3.49:6380

# Session
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# OAuth callbacks should use the reverse-proxied host (no :3001)
GOOGLE_CALLBACK_URL=http://130.245.136.45/auth/google/callback
GITHUB_CALLBACK_URL=http://130.245.136.45/auth/github/callback
OIDC_CALLBACK_URL=http://130.245.136.45/auth/oidc/callback
