# Nginx — production DMs VM (dms-service only)
#
# Use this on the dedicated DMs VM that runs the dms Node service locally.
# Frontend VM proxies /dms traffic here (private IP 10.0.3.52:80).
#
# Service on localhost (this VM):
#   3007 dms

upstream dms_backend {
    server 127.0.0.1:3007;
    keepalive 32;
}

server {
    listen 80;
    server_name 10.0.3.52;

    client_max_body_size 25m;

    location ^~ /dms {
        proxy_pass http://dms_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }

    # API-only host in split production
    location / {
        return 404;
    }
}
