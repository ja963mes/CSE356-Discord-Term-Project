# Nginx — production realtime VM (WebSocket ingress)
#
# Use this on the realtime VM(s). Runs two discord-realtime instances locally
# (:3005 and :3009) and load-balances WebSocket upgrades across them.
# The backend VM nginx proxies /ws here via private IP (10.0.3.180:80).
#
# Services on localhost (this VM):
#   3005 discord-realtime   (instance 1)
#   3009 discord-realtime-2 (instance 2)
#
# IMPORTANT: proxy_read_timeout must be >= the service's ping interval (25 s)
# plus headroom. 86400 (24 h) keeps idle WS connections alive through NAT.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream realtime_backend {
    server 127.0.0.1:3005;
    server 127.0.0.1:3009;
    server 127.0.0.1:3013;
    server 127.0.0.1:3017;
    keepalive 64;
}

server {
    listen 80;
    server_name _;

    location ^~ /ws {
        proxy_pass http://realtime_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }

    location = /healthz {
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 404;
    }
}
