# Nginx — production backend VM (API + WebSocket only)
#
# Use this on the backend VM. All Node services run on dedicated VMs — this
# host only proxies traffic to them via private IP.
#
# Services on localhost (this VM):
#   3002 communities (handles POST /create-community)
#
# All other services run on dedicated VMs — proxied via private IP:
#   messages   -> 10.0.3.199:80 (messages VM nginx)
#   realtime   -> 10.0.3.180:80 (realtime VM nginx 1, load-balances :3005/:3009/:3013/:3017)
#              -> 10.0.1.49:80  (realtime VM nginx 2, load-balances :3005/:3009/:3013/:3017)
#   dms        -> 10.0.3.52:80  (frontend nginx proxies directly)
#   read-state -> 10.0.1.189:80 (frontend nginx proxies directly)
#   auth       -> 10.0.3.158:80 (frontend nginx proxies directly)
#   search     -> 10.0.2.26:80  (frontend nginx proxies directly)

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream backend_communities {
    # communities-service runs on the communities VM (10.0.1.148) and serves
    # /create-community, /communities, /channels, /search-communities. The
    # communities VM nginx on :80 routes those paths to 127.0.0.1:3002.
    server 10.0.1.148:80;
    keepalive 32;
}
upstream backend_messages {
    # messages-service runs on its own VM (10.0.3.199). The backend VM nginx
    # proxies /messages and /attachments to the messages VM nginx on :80,
    # which in turn proxies to 127.0.0.1:3003 locally.
    server 10.0.3.199:80;
    keepalive 32;
}
# WebSocket: two realtime VMs, each running 4 local instances behind their own nginx.
upstream backend_realtime {
    server 10.0.3.180:80;
    server 10.0.1.49:80;
    keepalive 16;
}

server {
    listen 80;
    server_name 10.0.2.247;

    client_max_body_size 25m;

    location ^~ /create-community {
        proxy_pass http://backend_communities;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /communities {
        proxy_pass http://backend_communities;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /channels {
        proxy_pass http://backend_communities;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /messages {
        proxy_pass http://backend_messages;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /attachments {
        proxy_pass http://backend_messages;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /search-communities {
        proxy_pass http://backend_communities;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /ws {
        proxy_pass http://backend_realtime;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }

    # API-only host in split production
    location / {
        return 404;
    }
}
