# Nginx — production backend VM (API + WebSocket only)
#
# Use this on the backend VM that runs Node services locally.
# This host should not serve frontend static files in split production.
#
# Services expected on localhost:
#   3001 auth   3002 communities   3003 messages
#   3005 realtime (/ws)   3006 create-community   3007 dms   3008 read-state

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream backend_auth {
    server 127.0.0.1:3001;
    keepalive 32;
}
upstream backend_communities {
    server 127.0.0.1:3002;
    keepalive 32;
}
upstream backend_messages {
    server 127.0.0.1:3003;
    keepalive 32;
}
# WebSocket: list a second server only if discord-realtime-2 actually listens there. Otherwise nginx
# round-robins to a dead port and ~half of clients never get realtime (grading "Delivery timeout").
upstream backend_realtime {
    server 127.0.0.1:3005;
    server 127.0.0.1:3009;
    keepalive 16;
}

upstream backend_create_community {
    server 127.0.0.1:3006;
    keepalive 16;
}
upstream backend_dms {
    server 127.0.0.1:3007;
    keepalive 32;
}
upstream backend_read_state {
    server 127.0.0.1:3008;
    keepalive 16;
}

limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=100r/s;

map "$request_method$uri" $auth_bcrypt_ip_key {
    default                        "";
    "~^POST/auth/login$"           $binary_remote_addr;
    "~^POST/auth/register$"        $binary_remote_addr;
    "~^POST/auth/oauth/complete$"  $binary_remote_addr;
}
limit_req_zone $auth_bcrypt_ip_key zone=auth_bcrypt_per_ip:10m rate=20r/s;

map "$request_method$uri" $auth_bcrypt_global_key {
    default                        "";
    "~^POST/auth/login$"           "bcrypt";
    "~^POST/auth/register$"        "bcrypt";
    "~^POST/auth/oauth/complete$"  "bcrypt";
}
limit_req_zone $auth_bcrypt_global_key zone=auth_bcrypt_global:1m rate=100r/s;

server {
    listen 80;
    server_name 10.0.2.247;

    client_max_body_size 25m;

    location ^~ /auth {
        limit_req zone=auth_limit burst=200 nodelay;
        limit_req zone=auth_bcrypt_per_ip burst=40 nodelay;
        limit_req zone=auth_bcrypt_global burst=100 nodelay;
        limit_req_status 429;
        proxy_pass http://backend_auth;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /create-community {
        proxy_pass http://backend_create_community;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /communities {
        proxy_pass http://backend_communities;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /channels {
        proxy_pass http://backend_communities;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /messages {
        proxy_pass http://backend_messages;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /attachments {
        proxy_pass http://backend_messages;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /search-communities {
        proxy_pass http://backend_communities;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /dms {
        proxy_pass http://backend_dms;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /read-state {
        proxy_pass http://backend_read_state;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /ws {
        proxy_pass http://backend_realtime;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }

    # API-only host in split production
    location / {
        return 404;
    }
}
