# =============================================================================
# DEPRECATED — do not use for new deployments (retained for reference only).
# Supported baselines:
#   - Frontend VM: nginx-linode-production-frontend.conf.example
#   - Backend VM:  nginx-linode-production-backend.conf.example
# Guide: PROD-SPLIT-NGINX.md
# Single-box staging: prefer backend config for API ingress + run the SPA
# from Vite on your laptop, or merge `location` blocks from both canonical
# examples into one `server` (keep the same path order as frontend/vite.config.ts).
# =============================================================================
#
# Nginx — reverse proxy for full staging (matches frontend/vite.config.ts path order)
#
# Copy to /etc/nginx/sites-available/discord-staging, symlink sites-enabled,
# run `sudo nginx -t` and `sudo systemctl reload nginx`.
#
# Backend services (127.0.0.1, same as local dev):
#   3001 auth   3002 communities   3003 messages   3004 search
#   3005 realtime (WebSocket /ws)   3006 create-community   3007 dms
#   3008 read-state
#   optional: 8081 uptime-kuma (recommended direct access on IP:8081)
#
# Prefix notes:
# - /search-communities must win over /search (longer prefix; same as Vite).
# - /attachments → messages (3003): POST /attachments/presign for guild channel uploads.
#   The DM service also implements POST /attachments/presign on :3007; nginx can only
#   route one public path. Use /dms for DM APIs; if DM uploads need presign through this
#   host, point the client at a distinct path or run DMs on another ingress.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream vite_dev {
    server 127.0.0.1:5173;
}

limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=100r/s;

server {
    listen 80;
    listen 443 ssl;
    server_name 130.245.136.45 group-6.cse356.compas.cs.stonybrook.edu;

    ssl_certificate /etc/letsencrypt/live/group-6.cse356.compas.cs.stonybrook.edu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/group-6.cse356.compas.cs.stonybrook.edu/privkey.pem;

    # For HTTPS, add a second server block or use certbot --nginx.

    # Presigned-upload JSON bodies; raise if you increase attachment limits in app code.
    client_max_body_size 25m;

    # Shared proxy headers (OAuth callbacks need correct Host / forwarded proto)
    # Behind another TLS terminator, set X-Forwarded-Proto from that layer or use real_ip.

    # --- Same order as frontend/vite.config.ts `server.proxy` (see README proxy map) ---

    location ^~ /auth {
        limit_req zone=auth_limit burst=200 nodelay;
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /create-community {
        proxy_pass http://127.0.0.1:3006;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /communities {
        proxy_pass http://127.0.0.1:3002;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /channels {
        proxy_pass http://127.0.0.1:3002;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /messages {
        proxy_pass http://127.0.0.1:3003;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /attachments {
        proxy_pass http://127.0.0.1:3003;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /search-communities {
        proxy_pass http://127.0.0.1:3002;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Search (port 3004) — keep enabled when running the full staging stack.
    # If search is intentionally disabled, comment out this block to avoid /search 502s.
    location ^~ /search {
        proxy_pass http://127.0.0.1:3004;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /dms {
        proxy_pass http://127.0.0.1:3007;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /read-state {
        proxy_pass http://127.0.0.1:3008;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /ws {
        proxy_pass http://127.0.0.1:3005;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Uptime Kuma note:
    # For IP-only staging, use Kuma directly on host port 8081 (http://<ip>:8081).
    # Subpath proxying (/kuma/*) is intentionally omitted here because it is brittle
    # with Kuma's root-relative routes/assets on single-host, IP-based setups.

    # SPA: Vite dev server (npm run dev in frontend). For production static files,
    # replace this block with root/try_files to frontend/dist (see README build).
    location / {
        proxy_pass http://vite_dev;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}